# Optional. Unauthenticated GitHub REST API use is tightly rate-limited.
GITHUB_TOKEN=
CCN_SEED_REPOSITORY=NafeesMansoor/CodeCortex
CCN_MAX_REPOSITORIES=20
CCN_MAX_SEED_FORKS=10
CCN_MAX_SEARCH_QUERIES=5
# Optional one-hop expansion; keep both at zero to preserve seed-only searches.
CCN_MAX_EXPANSION_SEEDS=0
CCN_MAX_EXPANSION_QUERIES=0
CCN_REQUESTS_PER_MINUTE=30
CCN_REQUEST_TIMEOUT_SECONDS=10
CCN_GITHUB_API_URL=https://api.github.com
# Optional private repository used for durable, versioned Scout snapshots.
CCN_STORAGE_REPOSITORY=
CCN_STORAGE_BRANCH=main
